{
  "name": "qingdou-desktop-workbench",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "ui:dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "ui:build": "tsc --noEmit && vite build",
    "desktop:dev": "node scripts/desktop.mjs dev",
    "desktop:build": "node scripts/desktop.mjs build --bundles app",
    "native:test": "node scripts/desktop.mjs native-test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ui": "playwright test"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tauri-apps/cli": "^2.9.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.4"
  }
}
